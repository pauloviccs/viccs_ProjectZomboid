{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PZHub",
  "version": "2.0.0",
  "identifier": "com.viccs.pzhub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PZHub - Tactical Live Radar & Modpack Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
